# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui   # apenas server-side

# FastAPI Backend
FASTAPI_URL=http://localhost:8000        # Defina a URL do backend FastAPI local ou de deploy.
NEXT_PUBLIC_FASTAPI_WS_URL=ws://localhost:8000         # WebSocket URL pública

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=gere_um_secret_aleatorio_aqui          # openssl rand -base64 32

# Feature flags
NEXT_PUBLIC_ENABLE_STREAMING=true
NEXT_PUBLIC_ENABLE_REGIONAL_MAP=true
