# ============================================
# CULTURE PULSE V9 - Environment Variables
# ============================================
# Copie este arquivo para .env e preencha com suas chaves reais

# ============================================
# YOUTUBE API
# ============================================
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY_2=your_youtube_api_key_2_here  # Opcional (backup)
YOUTUBE_API_KEY_3=your_youtube_api_key_3_here  # Opcional (backup)

# ============================================
# REDDIT API
# ============================================
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=CulturePulse/1.0

# ============================================
# SPOTIFY API
# ============================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ============================================
# NEWS API
# ============================================
NEWS_API_KEY=your_news_api_key_here

# ============================================
# GOOGLE TRENDS (Opcional)
# ============================================
# Não requer chave - usa biblioteca pytrends

# ============================================
# INSTAGRAM (Opcional)
# ============================================
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here  # Opcional

# ============================================
# TWITTER/X (Opcional)
# ============================================
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here  # Opcional
TWITTER_API_KEY=your_twitter_api_key_here  # Opcional
TWITTER_API_SECRET=your_twitter_api_secret_here  # Opcional

# ============================================
# DATABASE (Opcional para produção)
# ============================================
DATABASE_URL=sqlite:///culture_pulse.db
REDIS_URL=redis://localhost:6379/0  # Opcional para cache

# ============================================
# AUTHENTICATION (Opcional)
# ============================================
JWT_SECRET_KEY=your_random_secret_key_here
JWT_ALGORITHM=HS256

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development  # development, staging, production
DEBUG=True
LOG_LEVEL=INFO
