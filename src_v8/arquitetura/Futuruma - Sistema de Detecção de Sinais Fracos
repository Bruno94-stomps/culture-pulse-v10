### 1. Detecção de Sinais Fracos (Ensemble)
```python
# ml/models/signal_detector.py

class SinalFracoDetector:
    """
    Detecta sinais fracos usando ensemble de:
    - BERTimbau (embeddings semânticos via HF Inference API)
    - XGBoost (features estruturadas)
    - HDBSCAN (clustering não-supervisionado)
    
    Precision@10: ~75-80

    % (após treino com 2k+ exemplos)
"""

def __init__(self):
    self.embedding_manager = HybridEmbeddingManager()
    self.xgboost = self._load_xgboost()
    self.clusterer = HDBSCAN(min_cluster_size=5)

def detectar(self, dados_coletados):
    """
    Pipeline completo de detecção
    
    Input: DataFrame com menções coletadas (1.5k-2k)
    Output: Lista de sinais fracos detectados
    """
    # 1. Feature engineering
    features = self.criar_features(dados_coletados)
    
    # 2. Gerar embeddings (batch ou buscar cache)
    embeddings = self.embedding_manager.get_embeddings_batch(
        textos=dados_coletados['texto'].tolist(),
        mencao_ids=dados_coletados['id'].tolist()
    )
    
    # 3. Calcular Momentum Cultural
    features['momentum'] = features.apply(
        self.calcular_momentum_cultural, axis=1
    )
    
    # 4. Detectar aceleração (2ª derivada temporal)
    features['aceleracao'] = self.calcular_aceleracao(features)
    
    # 5. Calcular dissonância narrativa (vs mainstream)
    features['dissonancia'] = self.calcular_dissonancia(embeddings)
    
    # 6. Concatenar embeddings + features estruturadas
    X = np.concatenate([
        embeddings,  # 768 dims
        features[self.feature_cols].values  # ~50 dims
    ], axis=1)
    # Total: 818 features
    
    # 7. XGBoost prediction
    probas = self.xgboost.predict_proba(X)
    scores = probas[:, 1]  # Probabilidade de ser sinal fraco
    
    # 8. Filtrar candidatos
    candidatos = dados_coletados[
        (scores > 0.6) &  # >60% confiança
        (features['momentum'] < 0.3) &  # Baixo momentum
        (features['aceleracao'] > 2.0)  # Alta aceleração
    ].copy()
    
    candidatos['score_confianca'] = scores[candidatos.index]
    
    # 9. Clustering (agrupar menções similares)
    if len(candidatos) >= 5:
        clusters = self.clusterer.fit_predict(
            embeddings[candidatos.index]
        )
        candidatos['cluster_id'] = clusters
    
    # 10. Consolidar clusters em sinais
    sinais = self.consolidar_clusters(candidatos)
    
    return sinais

def calcular_momentum_cultural(self, row):
    """
    Momentum = f(ressonância, velocidade, dispersão)
    """
    ressonancia = row['engagement_total'] / max(row['alcance'], 1)
    velocidade = row['taxa_crescimento']
    dispersao = 1 - row['gini_geografico']  # Inverso de concentração
    
    momentum = (
        ressonancia * 0.4 +
        velocidade * 0.4 +
        dispersao * 0.2
    )
    
    return np.clip(momentum, 0, 1)

def calcular_dissonancia(self, embeddings):
    """
    Mede dissonância com narrativa mainstream
    
    Compara embeddings das menções com embedding de narrativa dominante
    """
    # Embedding da narrativa mainstream (pré-calculado)
    mainstream_embedding = self._get_mainstream_embedding()
    
    # Similaridade cosseno
    similarities = cosine_similarity(embeddings, [mainstream_embedding])
    
    # Dissonância = 1 - similaridade
    dissonancia = 1 - similarities.flatten()
    
    return dissonancia

