```python
# ml/models/tension_analyzer.py

class AnalisadorTensaoCultural:
    """
    Analisa tensões culturais usando BERTimbau
    Mapeia nas 16 dimensões da Alma do Brasileiro
    """
    
    def __init__(self):
        self.embedding_manager = HybridEmbeddingManager()
        self.dimensoes_alma = self._carregar_dimensoes()
        self.nlp = spacy.load('pt_core_news_lg')
    
    def analisar(self, sinal_id):
        """
        Análise completa de tensão para um sinal
        """
        # 1. Buscar menções do sinal
        mencoes = self._get_mencoes(sinal_id)
        textos = [m['texto'] for m in mencoes]
        
        # 2. Gerar/buscar embeddings
        embeddings = self.embedding_manager.get_embeddings_batch(
            textos=textos,
            mencao_ids=[m['id'] for m in mencoes]
        )
        
        # 3. Detectar tensão semântica
        tensao = self.detectar_tensao_semantica(embeddings)
        
        # 4. Mapear dimensões da Alma
        dimensoes = self.mapear_dimensoes_alma(embeddings)
        
        # 5. Identificar problema e emoções (NLP)
        problema_emocao = self.identificar_problema_emocao(textos)
        
        # 6. Calcular dor da tensão
        dor = self.calcular_dor_tensao(textos, len(mencoes))
        
        return {
            'tensao_score': tensao['score'],
            'dispersao': tensao['dispersao'],
            'polarizacao': tensao['polarizacao'],
            'dimensoes_ativadas': dimensoes,
            'problema': problema_emocao['problema'],
            'emocoes': problema_emocao['emocoes'],
            'dor': dor
        }
    
    def detectar_tensao_semantica(self, embeddings):
        """
        Detecta tensão via dispersão + polarização
        """
        # Centroide
        centroide = np.mean(embeddings, axis=0)
        
        # Dispersão (quão espalhados estão os embeddings)
        dispersao = np.mean([
            cosine(emb, centroide) for emb in embeddings
        ])
        
        # Polarização (bimodalidade via k-means)
        if len(embeddings) >= 5:
            kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)
            clusters = kmeans.fit_predict(embeddings)
            
            # Distância entre centros
            distancia_clusters = cosine(
                kmeans.cluster_centers_[0],
                kmeans.cluster_centers_[1]
            )
            
            # Balanceamento (clusters similares = mais tensão)
            balanceamento = 1 - abs(np.mean(clusters) - 0.5) * 2
            
            polarizacao = distancia_clusters * balanceamento
        else:
            polarizacao = 0
        
        # Score de tensão
        tensao_score = (dispersao * 0.5 + polarizacao * 0.5) * 100
        
        return {
            'score': tensao_score,
            'dispersao': dispersao,
            'polarizacao': polarizacao
        }
    
    def mapear_dimensoes_alma(self, embeddings_sinal):
        """
        Mapeia quais das 16 dimensões estão ativadas
        """
        # Embedding médio do sinal
        embedding_sinal = np.mean(embeddings_sinal, axis=0)
        
        ativacoes = {}
        
        for dimensao, config in self.dimensoes_alma.items():
            # Embeddings dos polos (pré-calculados ou gerar)
            emb_pos = self._get_embedding_polo(config['polo_positivo'])
            emb_neg = self._get_embedding_polo(config['polo_negativo'])
            
            # Similaridade cosseno
            sim_pos = 1 - cosine(embedding_sinal, emb_pos)
            sim_neg = 1 - cosine(embedding_sinal, emb_neg)
            
            # Score normalizado (-1 a +1)
            score = sim_pos - sim_neg
            intensidade = max(sim_pos, sim_neg)
            
            if intensidade > 0.5:  # Threshold de relevância
                ativacoes[dimensao] = {
                    'score': float(score),
                    'intensidade': float(intensidade),
                    'polo_dominante': 'positivo' if score > 0 else 'negativo',
                    'confianca': float(intensidade)
                }
        
        # Ordenar por intensidade
        ativacoes_ordenadas = dict(sorted(
            ativacoes.items(),
            key=lambda x: x[1]['intensidade'],
            reverse=True
        ))
        
        return ativacoes_ordenadas
    
    def identificar_problema_emocao(self, textos):
        """
        Usa spaCy para identificar problemas e emoções
        """
        from collections import Counter
        
        problemas = []
        emocoes = []
        
        # Verbos negativos indicam problemas
        verbos_negativos = {
            'faltar', 'perder', 'destruir', 'ignorar',
            'excluir', 'oprimir', 'negar', 'esquecer'
        }
        
        for texto in textos:
            doc = self.nlp(texto)
            
            # Detectar problemas (substantivos após verbos negativos)
            for token in doc:
                if token.lemma_ in verbos_negativos:
                    for child in token.children:
                        if child.pos_ == 'NOUN':
                            problemas.append(child.text.lower())
            
            # Detectar emoções (adjetivos com carga emocional)
            for token in doc:
                if token.pos_ == 'ADJ':
                    emocoes.append(token.text.lower())
        
        return {
            'problema': Counter(problemas).most_common(5),
            'emocoes': Counter(emocoes).most_common(5)
        }
