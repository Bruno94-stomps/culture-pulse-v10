## 📊 Modelo de Dados

### Principais Entidades

#### 1. Sinais Fracos
```sql
CREATE TABLE sinais_fracos (
    id SERIAL PRIMARY KEY,
    titulo VARCHAR(500) NOT NULL,
    descricao TEXT,
    tipo VARCHAR(50),  -- comportamental, atitudinal, tecnológico, simbólico
    
    -- Momentum Cultural
    momentum_total FLOAT,
    ressonancia FLOAT,
    velocidade FLOAT,
    dispersao_geografica FLOAT,
    aceleracao FLOAT,
    
    -- Tensão Cultural
    tensao_score FLOAT,
    tensao_dispersao FLOAT,
    tensao_polarizacao FLOAT,
    
    -- Metadados
    num_mencoes INTEGER,
    fontes JSONB,  -- {reddit: 847, youtube: 423, ...}
    regioes JSONB,  -- ["Norte", "Nacional"]
    periodo_deteccao DATERANGE,
    
    -- Score de confiança do modelo
    score_confianca FLOAT,  -- 0-1 (XGBoost probability)
    nivel_confianca VARCHAR(20),  -- alta, media, baixa
    
    -- Validação (interna - não exposta)
    status_validacao VARCHAR(20),  -- pendente, validado, rejeitado, prematuro
    validado_por INTEGER REFERENCES usuarios(id),
    validado_em TIMESTAMPTZ,
    feedback_validacao TEXT,
    
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Índices
CREATE INDEX idx_sinais_momentum ON sinais_fracos(momentum_total);
CREATE INDEX idx_sinais_tensao ON sinais_fracos(tensao_score);
CREATE INDEX idx_sinais_status ON sinais_fracos(status_validacao);
CREATE INDEX idx_sinais_confianca ON sinais_fracos(score_confianca DESC);
CREATE INDEX idx_sinais_created ON sinais_fracos(created_at DESC);
```

#### 2. Menções (dados brutos das APIs)
```sql
CREATE TABLE mencoes (
    id SERIAL PRIMARY KEY,
    sinal_id INTEGER REFERENCES sinais_fracos(id),
    
    texto TEXT NOT NULL,
    titulo VARCHAR(1000),
    url TEXT,
    
    fonte VARCHAR(50),  -- reddit, youtube, twitter, etc
    fonte_id VARCHAR(200),  -- ID original na API
    fonte_metadados JSONB,  -- dados específicos da fonte
    
    autor VARCHAR(200),
    autor_verificado BOOLEAN DEFAULT FALSE,
    
    -- Engajamento
    score INTEGER DEFAULT 0,
    num_comentarios INTEGER DEFAULT 0,
    num_compartilhamentos INTEGER DEFAULT 0,
    engagement_total INTEGER,
    
